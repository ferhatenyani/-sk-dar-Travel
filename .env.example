# ——— Neon PostgreSQL (pooled connection string) ———
# Requis au BUILD aussi (pré-rendu ISR des pages publiques + sitemap).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ——— URL publique du site (sitemap, robots, SEO/JSON-LD) ———
# En prod : https://votre-site.vercel.app (ou domaine custom). NEXT_PUBLIC_*
# est inlinée au build → à définir avant le premier déploiement.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ——— Better Auth ———
BETTER_AUTH_SECRET="" # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000" # = URL de prod sur Vercel

# ——— UploadThing (images) ———
UPLOADTHING_TOKEN="" # token SDK v7+ (utdata / eyJ...), dashboard uploadthing.com → API Keys

# ——— Resend (optionnel — uniquement le lien « mot de passe oublié » admin) ———
# Sans clé : le lien de réinitialisation est loggé côté serveur (dev uniquement).
RESEND_API_KEY=""

# ——— Seed admin initial (pnpm db:seed, local uniquement) ———
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
